# Application
APP_ENV=development
LOG_LEVEL=INFO

# Azure AI Inference (LLM)
AZURE_AI_INFERENCE_ENDPOINT=
AZURE_AI_INFERENCE_API_KEY=
AZURE_AI_INFERENCE_MODEL=Kimi-K2.6

# ChromaDB (host port: 8002 ; service-to-service: chromadb:8000)
CHROMA_URL=http://chromadb:8000
CHROMA_COLLECTION=articles
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Hacker News API (public)
# Exemples d'endpoints:
# - ${NEWS_API_BASE_URL}/newstories.json
# - ${NEWS_API_BASE_URL}/item/<id>.json
NEWS_API_KEY=
NEWS_API_BASE_URL=https://hacker-news.firebaseio.com/v0

# Backend ↔ Frontend
BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
